# Render > Environment bo'limiga shu o'zgaruvchilarni kiriting. Haqiqiy qiymatlarni GitHub'ga yuklamang.

# @BotFather bergan token
BOT_TOKEN=123456789:AA...

# Neon > Connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Vercel'dagi frontend manzili (oxirida / belgisisiz)
WEBAPP_URL=https://kassachi.vercel.app

# Backendning ochiq manzili. Render'da RENDER_EXTERNAL_URL avtomatik beriladi, bu ixtiyoriy.
# PUBLIC_URL=https://kassachi-api.onrender.com

# Faqat lokal sinov uchun: 1 bo'lsa, Telegram'siz "x-dev-user" sarlavhasi bilan kirish mumkin. Production'da yoqmang.
DEV_AUTH=0
